# Server
PORT=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Workers
PRIORITY_HIGH_WORKERS=2
PRIORITY_MEDIUM_WORKERS=1
PRIORITY_LOW_WORKERS=1

# FFmpeg/ffprobe paths (auto-detected if not set)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Priority thresholds (MB)
PRIORITY_HIGH_MAX_MB=10
PRIORITY_MEDIUM_MAX_MB=50

# Cleanup
FILE_MAX_AGE_HOURS=24

# Webhook
WEBHOOK_MAX_RETRIES=3
WEBHOOK_BASE_DELAY_MS=1000
WEBHOOK_TIMEOUT_MS=10000

# Limits
MAX_FILE_SIZE_MB=200
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
